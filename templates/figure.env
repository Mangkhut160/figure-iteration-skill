# Per-figure settings (bash syntax). make_from_saved.sh and make_draft.sh read this file and export every variable in it.
# Copy to <figure folder>/figure.env and replace the two placeholder values with the numbers from the paper's profile
# (the paper's figure-profile.md, section "版面"); another paper's numbers must not stay here. A variable that is not set is not checked.
FIG_PAGE=WIDTHxHEIGHT   # page size in pt that the audit checks, e.g. 300x180: the venue's figure width x this figure's height. SVG route: make the width a multiple of 0.75 pt (Chromium rounds the page to CSS pixels)
FIG_SIZES=SIZES         # the only text sizes allowed in the PDF, comma separated, e.g. 6,7,8
# FIG_MIN_PPI=300       # lowest print resolution of a placed bitmap (default 300)
# FIG_MAX_MB=10         # largest PDF (MB) the submission system accepts
# FIG_INK=000000        # text colour (hex) of formulas the kit adds and of the SVG skeleton (default 000000)
# FIG_FONT=arial        # figgenie font key used to measure text
# FIG_LATIN=Arial       # font svg2pptx writes into the deck for Latin text
# LATEX_PREAMBLE='\usepackage{newtxmath}'      # math font, when the paper's is not Computer Modern
# LATEX_CACHE="$FIG_DIR/tools/latex_cache.json"   # keeps typeset formulas between runs
# FIG_FORBID="<word>,<phrase>"   # more words the attribution scan rejects, comma separated and quoted, e.g. tool, vendor or institution names (the account name stored in the saved deck is rejected automatically)
